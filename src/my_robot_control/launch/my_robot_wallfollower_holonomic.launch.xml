<?xml version="1.0"?>
<launch>
    <!-- Launch Arguments -->
    <arg name="distance_limit"  default="0.4"/>
    <arg name="tolerance"       default="0.05"/>
    <arg name="forward_speed"   default="0.10"/>
    <arg name="strafe_speed"    default="0.10"/>
    <arg name="turn_speed"      default="0.4"/>
    <arg name="time_to_stop"    default="200.0"/>

    <!-- Holonomic Wall Follower Node -->
    <node
        pkg="my_robot_control"
        exec="my_robot_wallfollower_holonomic_exec"
        name="wall_follower_holonomic_node"
        output="screen">

        <param name="distance_limit"  value="$(var distance_limit)"/>
        <param name="tolerance"       value="$(var tolerance)"/>
        <param name="forward_speed"   value="$(var forward_speed)"/>
        <param name="strafe_speed"    value="$(var strafe_speed)"/>
        <param name="turn_speed"      value="$(var turn_speed)"/>
        <param name="time_to_stop"    value="$(var time_to_stop)"/>
    </node>
</launch>
